{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assets.example.invalid/reviews/manifest.schema.v1.json",
  "title": "Reviews manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestVersion", "catalogSize", "products"],
  "properties": {
    "schemaVersion": { "const": "reviews.v1" },
    "manifestVersion": { "type": "string", "minLength": 1 },
    "catalogSize": { "type": "integer", "minimum": 0 },
    "sourceType": { "type": "string", "minLength": 1 },
    "stagingOnly": { "type": "boolean" },
    "aggregateDistributionVersion": { "type": "string", "minLength": 1 },
    "products": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/manifestEntry" }
    }
  },
  "$defs": {
    "positiveDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3", "4", "5"],
      "properties": {
        "1": { "type": "integer", "minimum": 1 },
        "2": { "type": "integer", "minimum": 1 },
        "3": { "type": "integer", "minimum": 1 },
        "4": { "type": "integer", "minimum": 1 },
        "5": { "type": "integer", "minimum": 1 }
      }
    },
    "emptyDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3", "4", "5"],
      "properties": {
        "1": { "const": 0 },
        "2": { "const": 0 },
        "3": { "const": 0 },
        "4": { "const": 0 },
        "5": { "const": 0 }
      }
    },
    "manifestEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rating", "reviewCount"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rating": { "type": ["number", "null"] },
        "reviewCount": { "type": "integer", "minimum": 0 },
        "distribution": { "type": "object" },
        "sourceType": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "reviewCount": { "const": 0 } } },
          "then": {
            "properties": {
              "rating": { "const": null },
              "distribution": { "$ref": "#/$defs/emptyDistribution" }
            }
          },
          "else": {
            "required": ["distribution"],
            "properties": {
              "rating": { "type": "number", "minimum": 4.1, "maximum": 5 },
              "reviewCount": { "type": "integer", "minimum": 12 },
              "distribution": { "$ref": "#/$defs/positiveDistribution" }
            }
          }
        }
      ],
      "$comment": "JSON Schema enforces the five exact keys and integer ranges. loader.v1.js additionally rejects a distribution whose sum differs from reviewCount or whose weighted mean differs from rating."
    }
  }
}
